# .github/workflows/build-rk3568-dg-nas-lite-dtb.yml
name: Build RK3568 DG-NAS-Lite DTB

on:
  push:
    branches: [ main ]
    paths:
      - 'arch/arm64/boot/dts/rockchip/rk3568-dg-nas-lite.dts'
      - 'arch/arm64/boot/dts/rockchip/rk3568.dtsi'
      - 'arch/arm64/boot/dts/rockchip/Makefile'
      - 'arch/arm64/configs/defconfig'
      - '.github/workflows/build-rk3568-dg-nas-lite-dtb.yml'
  pull_request:
    branches: [ main ]
    paths:
      - 'arch/arm64/boot/dts/rockchip/rk3568-dg-nas-lite.dts'
      - 'arch/arm64/boot/dts/rockchip/Makefile'
  workflow_dispatch:

concurrency:
  group: dtb-${{ github.ref }}-${{ github.workflow }}
  cancel-in-progress: true

jobs:
  build-dtb:
    name: Compile rk3568-dg-nas-lite.dtb
    runs-on: ubuntu-22.04

    steps:
      - name: Checkout source
        uses: actions/checkout@v4
        with:
          fetch-depth: 1

      - name: Install build dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y --no-install-recommends \
            bc bison build-essential cpio flex git \
            libelf-dev libssl-dev libncurses-dev \
            lz4 zstd \
            gcc-aarch64-linux-gnu \
            device-tree-compiler

      - name: Generate .config (arm64 defconfig)
        run: |
          make ARCH=arm64 CROSS_COMPILE=aarch64-linux-gnu- defconfig

      - name: Build Target DTB
        run: |
          # 🌟使用标准的 make dtbs 目标，100% 触发 Kbuild 遍历所有 subdir
          # 它会自动编译 Makefile 中注册的 rk3568-dg-nas-lite.dtb
          make ARCH=arm64 CROSS_COMPILE=aarch64-linux-gnu- -j$(nproc) dtbs

      - name: Verify output
        run: |
          ls -lh arch/arm64/boot/dts/rockchip/rk3568-dg-nas-lite.dtb
          dtc -I dtb -O dts \
              arch/arm64/boot/dts/rockchip/rk3568-dg-nas-lite.dtb \
              -o /tmp/rk3568-dg-nas-lite.verify.dts
          head -n 30 /tmp/rk3568-dg-nas-lite.verify.dts

      - name: Upload DTB artifact
        uses: actions/upload-artifact@v4
        with:
          name: rk3568-dg-nas-lite-dtb
          path: arch/arm64/boot/dts/rockchip/rk3568-dg-nas-lite.dtb
          if-no-files-found: error
          retention-days: 30
